{
  "name": "zerodha-rebalancer",
  "version": "1.0.0",
  "description": "Zerodha portfolio rebalancing agent using LangChain.js and Kite Connect API",
  "main": "dist/cli.js",
  "bin": {
    "rebalancer": "dist/cli.js"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths",
    "build:watch": "swc src -d dist --strip-leading-paths --watch",
    "start": "node dist/cli.js",
    "dev": "ts-node --transpile-only src/cli.ts",
    "dev:rebalance": "ts-node --transpile-only src/cli.ts rebalance --weights \"INFY:30,TCS:40,HDFC:30\"",
    "dev:pnl": "ts-node --transpile-only src/cli.ts pnl",
    "dev:holdings": "ts-node --transpile-only src/cli.ts holdings",
    "dev:recommend": "ts-node --transpile-only src/cli.ts recommend",
    "dev:query": "ts-node --transpile-only src/cli.ts query \"show me my portfolio weights\"",
    "dev:server": "ts-node --transpile-only src/server.ts",
    "dev:web": "(cd web && npm install --no-audit --no-fund) && (cd web && npm run dev)",
    "build:web": "cd web && npm run build",
    "build:all": "npm run build && npm run build:web",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/lib/tsc.js --project tsconfig.json --noEmit --skipLibCheck",
    "start:server": "node dist/server.js",
    "auth": "ts-node --transpile-only src/auth.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/anthropic": "0.3.15",
    "@langchain/core": "^0.3.0",
    "@langchain/google-genai": "0.1.6",
    "@langchain/groq": "0.1.3",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "kiteconnect": "^4.1.0",
    "langchain": "^0.3.0",
    "table": "^6.8.2",
    "winston": "^3.14.2",
    "winston-console-format": "^1.0.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
